<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>VerifyDNI</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<!-- Solo fondo oscuro. El logo animado lo gestiona LaunchScreenView en SwiftUI. -->
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- La app solo usa cifrado estándar del sistema (Security/CryptoKit/TLS) para
	     verificar firmas y conectar por HTTPS → exenta de documentación de exportación. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>es</string>
	</array>
	<!-- Esquemas consultados con canOpenURL (compartir resultado). Sin esta lista,
	     canOpenURL devuelve siempre false en iOS. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>googlegmail</string>
		<string>whatsapp</string>
		<string>tg</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>VerifyDNI usa la cámara para escanear el código QR del DNI digital (MiDNI) y la zona MRZ del DNI físico. Las imágenes se procesan en el dispositivo y no se guardan.</string>
	<key>NFCReaderUsageDescription</key>
	<string>VerifyDNI usa NFC para leer el chip del DNI físico y verificar su autenticidad. Los datos se procesan en el dispositivo.</string>
	<!-- ISO 7816 Application Identifiers — REQUIRED for NFCTagReaderSession to detect eMRTD chips (Spanish DNI, passports).
	     Without this list iOS 13+ will NOT connect to ISO 7816-4 tags.
	     A0000002471001 = ICAO 9303 eMRTD application (DNI, passports worldwide). -->
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>A0000002471001</string>
		<string>A000000003101001</string>
		<string>A000000003101002</string>
		<string>D2760000850100</string>
		<string>D2760000850101</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Excepción específica para el servidor de certificados de la Policía Nacional.
		     Su CA raíz (AC RAIZ DGP 2) no está en el almacén de iOS, por lo que
		     la evaluación de confianza la realiza PoliciaURLSessionDelegate mediante
		     SecTrustSetAnchorCertificates. Sin esta entrada ATS bloquea la conexión
		     antes de que el delegado pueda intervenir. -->
		<key>NSExceptionDomains</key>
		<dict>
			<key>pki.policia.es</key>
			<dict>
				<!-- Mantener HTTPS obligatorio -->
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<!-- Relajar forward secrecy para compatibilidad con el servidor del gobierno -->
				<key>NSThirdPartyExceptionRequiresForwardSecrecy</key>
				<false/>
				<!-- TLS 1.2 mínimo -->
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
